{
  "manifest_version": 3,
  "name": "__MSG_title__",
  "version": "${version}",
  "minimum_chrome_version": "100.0.0.0",
  "description": "__MSG_description__",
  "author": "ainlee",
  "homepage_url": "https://github.com/ainlee/Last-Session-PLUS",
  "default_locale": "en",
  "icons": {
    "16": "assets/icons/light/icon-16.png",
    "32": "assets/icons/light/icon-32.png",
    "48": "assets/icons/light/icon-48.png",
    "64": "assets/icons/light/icon-64.png",
    "128": "assets/icons/light/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_title__",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "${options_ui.page}",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sessions", "storage", "tabs", "tabGroups", "offscreen", "identity"],
  "host_permissions": ["<all_urls>"]
}
